{
  "name": "neocoach",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NeoCoach — a modern all-in-one student productivity and learning desktop app that works fully offline.",
  "author": "Anush Kushwaha",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/launch-electron-dev.cjs",
    "build": "vite build",
    "build:electron": "vite build && node scripts/launch-electron-built.cjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "electron-builder",
    "clean:release": "powershell -NoProfile -Command \"Get-Process -Name 'LifeOS','electron' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; if (Test-Path release) { Remove-Item -Recurse -Force release -ErrorAction SilentlyContinue }\"",
    "build:release:win": "npm run clean:release && npm run build && npx electron-builder --win",
    "check:ai": "node --check electron/aiGateway.cjs && node --input-type=module --check < src/libs/aiProviders.js",
    "focusguard:repair": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts-repair-focusguard.ps1",
    "test:focusguard": "node scripts/test-focusguard-v32.cjs",
    "test:app-shell": "node scripts/test-app-shell.cjs",
    "test:lifeos-safety": "node scripts/test-focusguard-v32.cjs",
    "test:focusguard-rebuild": "node scripts/test-focusguard-v32.cjs",
    "test:focusguard-v19": "node scripts/test-focusguard-v32.cjs",
    "test:focusguard-v20": "node scripts/test-focusguard-v32.cjs",
    "test:app-startup": "node scripts/test-app-startup.cjs",
    "test:focusguard-v22": "node scripts/test-focusguard-v32.cjs",
    "test:focusguard-v23": "node scripts/test-focusguard-v32.cjs",
    "test:focusguard-worker-policy": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& '.\\electron\\focusGuardWorker.ps1' -ParentPid $PID -AllowedAppsBase64 W10= -BlockedAppsBase64 W10= -LifeOSRootBase64 W10= -ParentExePathBase64 W10= -SessionId test -ProtectedPidsBase64 W10= -TestMode\"",
    "test:focusguard-v24": "node scripts/test-focusguard-v32.cjs",
    "test:focusguard-v32": "node scripts/test-focusguard-v32.cjs"
  },
  "dependencies": {
    "@ariakit/react": "0.4.19",
    "@blocknote/ariakit": "0.54.0",
    "@blocknote/core": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@langchain/core": "^1.2.9",
    "@langchain/google": "^0.2.3",
    "@langchain/groq": "^1.3.1",
    "@langchain/tavily": "^1.2.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.84.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.2",
    "firebase": "^12.18.0",
    "framer-motion": "^11.16.4",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "katex": "^0.18.4",
    "langchain": "^1.5.10",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^9.0.1",
    "react-quill-new": "^3.7.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.171.0",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.neocoach.app",
    "productName": "NeoCoach",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeoCoach"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "asarUnpack": [
      "electron/*.ps1",
      "electron/*.png",
      "electron/focusGuardEnforcer.cjs"
    ],
    "extraResources": [
      {
        "from": "Emergency-FocusGuard.cmd",
        "to": "Emergency-FocusGuard.cmd"
      },
      {
        "from": "electron/focusGuardRecovery.ps1",
        "to": "focusGuardRecovery.ps1"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
